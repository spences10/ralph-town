{
	"name": "ralph-town-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run ralph-town#dev",
		"check": "vp check && vp run -r check",
		"check:fix": "vp check --fix && vp run -r check:fix",
		"format": "vp check --fix",
		"test": "vp run -r test",
		"test:watch": "vp run -r test:watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@types/node": "^26.0.0",
		"dotenv": "^18.0.9",
		"typescript": "^7.0.0",
		"vite-plus": "^1.4.0",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.16.1"
}
